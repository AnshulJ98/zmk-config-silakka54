 *
 * Stage 0 keymap — deliberately minimal. Layer changes graduate from
 * ZMK Studio experiments into this file; this file is the truth.
 *
 * Physical position indices (matches silakka54-layouts.dtsi order):
 *   0-11 number row, 12-23 top row, 24-35 home row, 36-47 bottom row,
 *   48-50 left thumbs (outer->inner), 51-53 right thumbs (inner->outer).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define LOWER 1
#define RAISE 2

/*
 * ── Week-3 scaffold: urob-style "timeless" home row mods. NOT ACTIVE. ──
 * To enable: uncomment the defines and the behaviors block, then replace
 * home-row taps in base_layer with e.g. &hml LCTRL A ... &hmr RCTRL SEMI.
 * balanced flavor + require-prior-idle-ms means a hold only registers when
 * you pause first or chord with the opposite hand — no misfires mid-roll.
 *
 * #define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41
 * #define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47
 * #define THUMBS 48 49 50 51 52 53
 *
 * / {
 *     behaviors {
 *         hml: home_row_mod_left {
 *             compatible = "zmk,behavior-hold-tap";
 *             #binding-cells = <2>;
 *             flavor = "balanced";
 *             tapping-term-ms = <280>;
 *             quick-tap-ms = <175>;
 *             require-prior-idle-ms = <150>;
 *             bindings = <&kp>, <&kp>;
 *             hold-trigger-key-positions = <KEYS_R THUMBS>;
 *             hold-trigger-on-release;
 *         };
 *         hmr: home_row_mod_right {
 *             compatible = "zmk,behavior-hold-tap";
 *             #binding-cells = <2>;
 *             flavor = "balanced";
 *             tapping-term-ms = <280>;
 *             quick-tap-ms = <175>;
 *             require-prior-idle-ms = <150>;
 *             bindings = <&kp>, <&kp>;
 *             hold-trigger-key-positions = <KEYS_L THUMBS>;
 *             hold-trigger-on-release;
 *         };
 *     };
 * };
 */

/* Caps behaves as a toggle: second press cancels. SPACE added so caps
 * survive across words; Enter/punctuation still auto-cancel as a safety
 * net, since the board has no caps indicator. */
&caps_word {
    continue-list = <UNDERSCORE BACKSPACE DELETE SPACE>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp LALT  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5        &kp N6  &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T         &kp Y   &kp U  &kp I     &kp O   &kp P    &kp RCTRL
&kp ESC   &kp A  &kp S  &kp D  &kp F  &kp G         &kp H   &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B         &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &kp RALT
                 &kp LGUI &mo LOWER &kp SPACE       &kp RET &mo RAISE &kp BSPC
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&studio_unlock &kp F1 &kp F2 &kp F3 &kp F4 &kp F5    &kp F6   &kp F7   &kp F8    &kp F9 &kp F10   &trans
&kp LS(TAB) &trans &trans   &trans &kp LBKT &kp TILDE &trans   &kp RBKT &kp PLUS  &trans &trans    &trans
&caps_word &trans &kp PIPE &kp AMPS &kp LPAR &kp GRAVE &kp LT  &kp RPAR &kp EQUAL &kp GT &kp QMARK &trans
&trans &trans &trans   &trans   &kp LBRC &trans       &kp BSLH &kp RBRC &trans    &trans &trans    &trans
                       &trans &trans &trans              &trans &trans &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &studio_unlock &bt BT_CLR  &trans   &trans    &trans   &trans    &trans  &trans
&trans       &trans       &trans       &trans       &trans       &trans        &kp HOME &kp PG_DN &kp PG_UP &kp END  &kp DEL &trans
&trans       &trans       &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP      &kp LEFT &kp DOWN  &kp UP   &kp RIGHT &trans  &trans
&trans       &trans       &trans       &kp C_PREV   &kp C_NEXT   &trans        &trans   &trans    &trans   &trans    &trans  &trans
                          &trans &trans &kp LG(SPACE)                          &trans &trans &trans
            >;
        };
    };
};
